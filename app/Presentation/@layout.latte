{varType string $lang}
{varType list<string> $languages}
{varType bool $languageSwitch}
{varType string $appVersion}
<!DOCTYPE html>
<html lang="{$lang}" data-bs-theme="light">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex, nofollow">
	<title>{ifset title}{include title|stripHtml|trim} | {/ifset}{_'system.app.name'}</title>
	<script src="{$basePath}/assets/admin/theme.js?v={$appVersion}"></script>
	<link rel="stylesheet" href="{$basePath}/assets/vendor/bootstrap-5.3.9/css/bootstrap.min.css">
	<link rel="stylesheet" href="{$basePath}/assets/admin/admin.css?v={$appVersion}">
</head>

<body class="d-flex flex-column min-vh-100">
	{* Icons from Bootstrap Icons (MIT): sun-fill, moon-stars-fill, circle-half, person-circle *}
	<svg xmlns="http://www.w3.org/2000/svg" class="d-none">
		<symbol id="icon-theme-light" viewBox="0 0 16 16">
			<path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"/>
		</symbol>
		<symbol id="icon-theme-dark" viewBox="0 0 16 16">
			<path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/>
			<path d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.734 1.734 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.734 1.734 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.734 1.734 0 0 0 1.097-1.097l.387-1.162z"/>
		</symbol>
		<symbol id="icon-theme-auto" viewBox="0 0 16 16">
			<path d="M8 15A7 7 0 1 0 8 1v14zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16z"/>
		</symbol>
		<symbol id="icon-person" viewBox="0 0 16 16">
			<path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
			<path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
		</symbol>
	</svg>

	<nav class="navbar navbar-expand-xl bg-body-tertiary border-bottom">
		<div class="container-xxl">
			<a class="navbar-brand fw-semibold" n:href=":Admin:Dashboard:">{_'system.app.name'}</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
				aria-controls="main-nav" aria-expanded="false" aria-label="{_'admin.menu.toggle'}">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="main-nav">
				<ul class="navbar-nav me-auto" n:if="$user->isLoggedIn()">
					<li class="nav-item" n:if="$user->isAllowed('dashboard', 'view')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Dashboard:*') ? active" n:href=":Admin:Dashboard:">{_'admin.menu.dashboard'}</a>
					</li>
					<li class="nav-item" n:if="$user->isAllowed('events', 'view')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Events:*') ? active" n:href=":Admin:Events:">{_'admin.menu.events'}</a>
					</li>
					<li class="nav-item" n:if="$user->isAllowed('accounts', 'view')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Accounts:*') ? active" n:href=":Admin:Accounts:">{_'admin.menu.accounts'}</a>
					</li>
					<li class="nav-item" n:if="$user->isAllowed('policy', 'view')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Policy:*') ? active" n:href=":Admin:Policy:">{_'admin.menu.policy'}</a>
					</li>
					<li class="nav-item" n:if="$user->isAllowed('knowledge', 'view')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Knowledge:*') ? active" n:href=":Admin:Knowledge:">{_'admin.menu.knowledge'}</a>
					</li>
					<li class="nav-item" n:if="$user->isAllowed('evaluation', 'view')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Evaluation:*') ? active" n:href=":Admin:Evaluation:">{_'admin.menu.evaluation'}</a>
					</li>
					<li class="nav-item" n:if="$user->isAllowed('operators', 'manage')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Operators:*') ? active" n:href=":Admin:Operators:">{_'admin.menu.operators'}</a>
					</li>
					<li class="nav-item" n:if="$user->isAllowed('audit', 'view')">
						<a n:class="nav-link, $presenter->isLinkCurrent(':Admin:Audit:*') ? active" n:href=":Admin:Audit:">{_'admin.menu.audit'}</a>
					</li>
				</ul>

				<ul class="navbar-nav ms-auto align-items-xl-center">
					<li class="nav-item dropdown" n:if="$languageSwitch">
						<button class="btn btn-link nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown"
							aria-expanded="false" aria-label="{_'admin.menu.language'}">
							{_"system.language.$lang"}
						</button>
						<ul class="dropdown-menu dropdown-menu-end">
							<li n:foreach="$languages as $code">
								<a n:class="dropdown-item, $code === $lang ? active" n:href="this, lang: $code"
									n:attr="aria-current: $code === $lang ? page" lang="{$code}">{_"system.language.$code"}</a>
							</li>
						</ul>
					</li>

					<li class="nav-item dropdown">
						<button class="btn btn-link nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown"
							aria-expanded="false" aria-label="{_'admin.menu.theme'}" title="{_'admin.menu.theme'}">
							<svg class="icon"><use href="#icon-theme-auto" data-theme-icon></use></svg>
							<span class="d-xl-none ms-1">{_'admin.menu.theme'}</span>
						</button>
						<ul class="dropdown-menu dropdown-menu-end">
							<li n:foreach="['light', 'dark', 'auto'] as $theme">
								<button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="{$theme}" aria-pressed="false">
									<svg class="icon"><use href="#icon-theme-{$theme}"></use></svg>
									{_"admin.theme.$theme"}
								</button>
							</li>
						</ul>
					</li>

					<li class="nav-item dropdown" n:if="$user->isLoggedIn()">
						{var Nette\Security\IIdentity $identity = $user->getIdentity()}
						<button class="btn btn-link nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
							<svg class="icon"><use href="#icon-person"></use></svg>
							{$identity->getData()['name']}
						</button>
						<ul class="dropdown-menu dropdown-menu-end">
							<li><span class="dropdown-item-text small text-body-secondary">{$identity->getData()['email']}</span></li>
							<li n:foreach="$identity->getRoles() as $role">
								<span class="dropdown-item-text small text-body-secondary">{_"operator.role.$role"}</span>
							</li>
							<li><hr class="dropdown-divider"></li>
							<li><a class="dropdown-item" n:href=":Admin:Password:">{_'admin.menu.password'}</a></li>
							<li><a class="dropdown-item" n:href=":Sign:out">{_'admin.menu.logout'}</a></li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</nav>

	<main class="container-xxl py-4 flex-grow-1">
		<div n:foreach="$flashes as $flash" class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
			{_$flash->message}
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{_'admin.close'}"></button>
		</div>

		{include content}
	</main>

	<footer class="border-top py-3 small text-body-secondary">
		<div class="container-xxl">{_'system.app.version', 1, [version => $appVersion]}</div>
	</footer>

	<script src="{$basePath}/assets/vendor/bootstrap-5.3.9/js/bootstrap.bundle.min.js"></script>
</body>
</html>
