{varType string $lang}
{varType list<string> $languages}
{varType bool $languageSwitch}
{varType string $appVersion}
{varType string $icons}
{* Sidebar menu: group => [presenter, ACL resource, privilege, name]; the name (default: the resource) is the icon and the label key. *}
{var $menu = [
	operations => [
		['Dashboard', 'dashboard', 'view'],
		['Review', 'events', 'view', 'review'],
		['Events', 'events', 'view'],
		['Conversations', 'conversations', 'view'],
		['Actions', 'actions', 'view'],
	],
	settings => [
		['Accounts', 'accounts', 'view'],
		['Policy', 'policy', 'view'],
		['Knowledge', 'knowledge', 'view'],
		['Alarms', 'alarms', 'manage'],
		['Retention', 'retention', 'manage'],
	],
	management => [
		['Evaluation', 'evaluation', 'view'],
		['Operators', 'operators', 'manage'],
		['Audit', 'audit', 'view'],
		['Privacy', 'privacy', 'manage'],
	],
]}
<!DOCTYPE html>
<html lang="{$lang}" data-coreui-theme="light">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex, nofollow">
	<title>{ifset title}{include title|stripHtml|trim} | {/ifset}{_'system.app.name'}</title>
	{* Generated from assets/brand/favicon-social-ai.png *}
	<link rel="icon" href="{$basePath}/favicon.ico" sizes="any">
	<link rel="icon" href="{$basePath}/assets/admin/icon-192.png?v={$appVersion}" type="image/png" sizes="192x192">
	<link rel="apple-touch-icon" href="{$basePath}/assets/admin/apple-touch-icon.png?v={$appVersion}">
	<script src="{$basePath}/assets/admin/theme.js?v={$appVersion}"></script>
	<link rel="stylesheet" href="{$basePath}/assets/vendor/coreui-5.9.1/css/coreui.min.css">
	<link rel="stylesheet" href="{$basePath}/assets/admin/admin.css?v={$appVersion}">
</head>

<body>
	<div n:if="$user->isLoggedIn()" class="sidebar sidebar-dark sidebar-fixed border-end" id="sidebar">
		<div class="sidebar-header border-bottom">
			<a class="sidebar-brand text-decoration-none fw-semibold" n:href=":Admin:Dashboard:">
				<img src="{$basePath}/assets/admin/icon-192.png?v={$appVersion}" alt="" width="28" height="28" class="me-2 rounded">
				{_'system.app.name'}
			</a>
			<button class="btn-close btn-close-white d-lg-none" type="button" data-coreui-close="sidebar" aria-label="{_'admin.close'}"></button>
		</div>
		<ul class="sidebar-nav">
			{foreach $menu as $group => $items}
				{var $visible = array_filter($items, fn(array $item): bool => $user->isAllowed($item[1], $item[2]))}
				<li n:if="$visible !== []" class="nav-title">{_"admin.menu.group.$group"}</li>
				<li n:foreach="$visible as $item" class="nav-item">
					{var $target = ':Admin:' . $item[0] . ':'}
					{var $name = $item[3] ?? $item[1]}
					<a n:class="nav-link, $presenter->isLinkCurrent($target . '*') ? active" n:href="$target"
						n:attr="aria-current: $presenter->isLinkCurrent($target . '*') ? page">
						<svg class="nav-icon" aria-hidden="true"><use href="{$icons}#{$name}"></use></svg>
						{_"admin.menu.$name"}
					</a>
				</li>
			{/foreach}
		</ul>
	</div>

	<div class="wrapper d-flex flex-column min-vh-100">
		<header class="header header-sticky p-0 mb-4">
			<div class="container-fluid border-bottom px-4">
				<button n:if="$user->isLoggedIn()" class="header-toggler" type="button" data-sidebar-toggle="sidebar"
					aria-controls="sidebar" aria-label="{_'admin.menu.toggle'}">
					<svg class="icon icon-lg" aria-hidden="true"><use href="{$icons}#menu"></use></svg>
				</button>
				<a n:if="!$user->isLoggedIn()" class="header-brand fw-semibold text-decoration-none" n:href=":Admin:Dashboard:">{_'system.app.name'}</a>

				<ul class="header-nav ms-auto">
					<li class="nav-item dropdown" n:if="$languageSwitch">
						<button class="btn btn-link nav-link dropdown-toggle" type="button" data-coreui-toggle="dropdown"
							aria-expanded="false" aria-label="{_'admin.menu.language'}">
							<svg class="icon me-1" aria-hidden="true"><use href="{$icons}#language"></use></svg>
							<span class="d-none d-sm-inline">{_"system.language.$lang"}</span>
						</button>
						<ul class="dropdown-menu dropdown-menu-end">
							<li n:foreach="$languages as $code">
								<a n:class="dropdown-item, $code === $lang ? active" n:href="this, lang: $code"
									n:attr="aria-current: $code === $lang ? page" lang="{$code}">{_"system.language.$code"}</a>
							</li>
						</ul>
					</li>

					<li class="nav-item dropdown">
						<button class="btn btn-link nav-link dropdown-toggle" type="button" data-coreui-toggle="dropdown"
							aria-expanded="false" aria-label="{_'admin.menu.theme'}" title="{_'admin.menu.theme'}">
							<svg class="icon" aria-hidden="true"><use href="{$icons}#theme-auto" data-theme-icon></use></svg>
						</button>
						<ul class="dropdown-menu dropdown-menu-end">
							<li n:foreach="['light', 'dark', 'auto'] as $theme">
								<button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="{$theme}" aria-pressed="false">
									<svg class="icon" aria-hidden="true"><use href="{$icons}#theme-{$theme}"></use></svg>
									{_"admin.theme.$theme"}
								</button>
							</li>
						</ul>
					</li>

					<li class="nav-item dropdown" n:if="$user->isLoggedIn()">
						{var Nette\Security\IIdentity $identity = $user->getIdentity()}
						<button class="btn btn-link nav-link dropdown-toggle" type="button" data-coreui-toggle="dropdown" aria-expanded="false">
							<svg class="icon icon-lg" aria-hidden="true"><use href="{$icons}#person"></use></svg>
							<span class="d-none d-md-inline ms-1">{$identity->getData()['name']}</span>
						</button>
						<ul class="dropdown-menu dropdown-menu-end">
							<li><span class="dropdown-item-text small text-body-secondary">{$identity->getData()['email']}</span></li>
							<li n:foreach="$identity->getRoles() as $role">
								<span class="dropdown-item-text small text-body-secondary">{_"operator.role.$role"}</span>
							</li>
							<li><hr class="dropdown-divider"></li>
							<li>
								<a class="dropdown-item d-flex align-items-center gap-2" n:href=":Admin:Password:">
									<svg class="icon" aria-hidden="true"><use href="{$icons}#password"></use></svg>
									{_'admin.menu.password'}
								</a>
							</li>
							<li>
								<a class="dropdown-item d-flex align-items-center gap-2" n:href=":Sign:out">
									<svg class="icon" aria-hidden="true"><use href="{$icons}#logout"></use></svg>
									{_'admin.menu.logout'}
								</a>
							</li>
						</ul>
					</li>
				</ul>
			</div>
		</header>

		<main class="body flex-grow-1">
			<div class="container-xxl px-4">
				<div n:foreach="$flashes as $flash" class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
					{_$flash->message}
					<button type="button" class="btn-close" data-coreui-dismiss="alert" aria-label="{_'admin.close'}"></button>
				</div>

				{include content}
			</div>
		</main>

		<footer class="footer px-4 mt-4 small text-body-secondary">
			<div>{_'system.app.version', 1, [version => $appVersion]}</div>
		</footer>
	</div>

	<script src="{$basePath}/assets/vendor/coreui-5.9.1/js/coreui.bundle.min.js"></script>
	<script src="{$basePath}/assets/admin/admin.js?v={$appVersion}"></script>
	{block scripts}{/block}
</body>
</html>
