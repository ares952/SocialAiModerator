{varType list<Nette\Database\Row> $accounts}
{varType bool $canManage}
{varType array<string, array<string, mixed>> $charts}
{import '../@chart.latte'}

{block content}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
	<h1 class="h3 mb-0" n:block="title">{_'account.title'}</h1>
	<a n:if="$canManage" class="btn btn-primary" n:href="add">{_'account.add'}</a>
</div>
<p class="text-body-secondary">{_'account.note'}</p>
<p class="text-body-secondary small">{_'account.token.note'}</p>

{if $accounts === []}
	<div class="alert alert-secondary">{_'account.empty'}</div>
{else}
	<div class="card mb-4">
		<div class="card-body">
			<h2 class="h5 card-title mb-3">{_'account.chart.events'}</h2>
			{if $charts['events']['datasets'] === []}
				<p class="text-body-secondary mb-0">{_'chart.empty'}</p>
			{else}
				{include chart, $charts['events'], export: events}
			{/if}
		</div>
	</div>

	<div class="table-responsive">
		<table class="table table-hover align-middle">
			<thead>
				<tr>
					<th scope="col">{_'account.column.name'}</th>
					<th scope="col">{_'account.column.platform'}</th>
					<th scope="col">{_'account.column.status'}</th>
					<th scope="col">{_'account.column.token'}</th>
					<th scope="col">{_'account.column.events'}</th>
					<th scope="col">{_'account.column.automation'}</th>
					<th scope="col" n:if="$canManage"><span class="visually-hidden">{_'common.actions'}</span></th>
				</tr>
			</thead>
			<tbody>
				<tr n:foreach="$accounts as $account">
					<td>{$account->name}<div class="small text-body-secondary">{$account->external_id}</div></td>
					<td><span class="badge badge-platform badge-{$account->platform}">{_"platform.{$account->platform}"}</span></td>
					<td>
						<span n:class="badge, $account->status === 'active' ? 'text-bg-success' : 'text-bg-secondary'">{_"account.status.{$account->status}"}</span>
					</td>
					<td>
						{if $account->token_status === null}
							<span class="badge text-bg-warning">{_'account.token.none'}</span>
						{else}
							<span n:class="badge, $account->token_status === 'valid' ? 'text-bg-success' : ($account->token_status === 'invalid' ? 'text-bg-danger' : 'text-bg-secondary')">{_"account.token.status.{$account->token_status}"}</span>
							<div class="small text-body-secondary">
								{_"account.token.type.{$account->token_type}"}<br>
								{if $account->token_expires_at}{_'account.token.expires', 1, [date => ($account->token_expires_at|localTime)]}{else}{_'account.token.never'}{/if}
								{if $account->token_data_access_expires_at}<br>{_'account.token.data-access', 1, [date => ($account->token_data_access_expires_at|localTime)]}{/if}
								<br>{_'account.token.refreshed', 1, [date => ($account->token_refreshed_at|localTime)]}
							</div>
						{/if}
					</td>
					<td>{$account->events_day}</td>
					<td>
						{if $account->paused}
							<span class="badge text-bg-danger">{_'automation.state.paused-short'}</span>
						{else}
							<span class="text-body-secondary">—</span>
						{/if}
					</td>
					<td n:if="$canManage" class="text-end text-nowrap">
						<a class="btn btn-sm btn-outline-secondary" n:href="edit, id: $account->id">{_'common.edit'}</a>
						<a class="btn btn-sm btn-outline-secondary" n:href="token, id: $account->id">{_'account.token.action'}</a>
						{if $account->paused}
							<a class="btn btn-sm btn-outline-success" n:href="resume!, account: $account->id">{_'automation.form.resume'}</a>
						{else}
							<a class="btn btn-sm btn-outline-danger" n:href="pause!, account: $account->id">{_'automation.form.pause'}</a>
						{/if}
					</td>
				</tr>
			</tbody>
		</table>
	</div>
{/if}
{/block}

{block scripts}{include chartScripts}{/block}
