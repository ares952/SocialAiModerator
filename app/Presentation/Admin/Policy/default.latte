{varType App\Moderation\Policy $policy}
{varType list<Nette\Database\Row> $history}
{varType Nette\Database\Row|null $pause}
{varType bool $canManage}
{varType list<App\Moderation\Strictness> $presets}
{varType list<App\Moderation\AbuseType> $abuseTypes}

{block content}
<h1 class="h3 mb-4" n:block="title">{_'policy.title'}</h1>

<div n:class="card, mb-4, $pause ? 'border-danger' : 'border-success'">
	<div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
		<div>
			<h2 class="h5 mb-1">{_'automation.title'}</h2>
			{if $pause}
				<p class="mb-0 text-danger-emphasis">
					{_'automation.state.paused', 1, [name => $pause->paused_by_name ?? '—', time => ($pause->paused_at|localTime)]}
				</p>
				<p n:if="$pause->reason" class="mb-0 small text-body-secondary">{$pause->reason}</p>
			{else}
				<p class="mb-0 text-success-emphasis">{_'automation.state.running'}</p>
			{/if}
			<p class="mb-0 small text-body-secondary">{_'automation.note'}</p>
		</div>
		<div n:if="$canManage">
			{if $pause}
				{control resumeForm}
			{else}
				<form n:name="pauseForm" class="d-flex flex-wrap gap-2 align-items-start">
					<input n:name="reason" class="form-control" placeholder="{_'automation.form.reason'}">
					<button n:name="pause" class="btn btn-danger">{_'automation.form.pause'}</button>
				</form>
			{/if}
		</div>
	</div>
</div>

{var $settings = $policy->settings}
<div class="card mb-4">
	<div class="card-header d-flex flex-wrap align-items-center gap-2">
		<span class="me-auto">{_'policy.strictness.title'}</span>
		<span n:class="badge, $settings->strictness === App\Moderation\Strictness::Custom ? text-bg-danger : text-bg-info">
			{_"policy.strictness.{$settings->strictness->value}"}
		</span>
	</div>
	<div class="card-body">
		<p class="small text-body-secondary">{_'policy.strictness.note'}</p>
		{if $canManage}
			<form n:name="strictnessForm" class="strictness-form">
				<div n:foreach="$form->getOwnErrors() as $error" class="alert alert-danger">{$error}</div>
				<div class="row g-2 mb-3">
					<div n:foreach="App\Moderation\Strictness::cases() as $level" class="col-6 col-lg-3">
						<input n:name="strictness:{$level->value}" class="btn-check">
						<label n:name="strictness:{$level->value}" n:class="btn, w-100, h-100, text-start, $level === App\Moderation\Strictness::Custom ? btn-outline-danger : btn-outline-primary">
							<span class="d-block fw-semibold">{_"policy.strictness.{$level->value}"}</span>
							<small class="d-block">{_"policy.strictness.{$level->value}.summary"}</small>
						</label>
					</div>
				</div>

				<div n:foreach="$presets as $preset" class="strictness-panel strictness-panel-{$preset->value}">
					{include rules, spam: $preset->spamHideMin(), rules: $preset->abuseRules(), mixed: null, types: $abuseTypes, confidence: $settings->hideMinConfidence}
				</div>

				<div class="strictness-panel strictness-panel-custom">
					<div class="alert alert-danger">
						<h3 class="h6">{_'policy.strictness.custom.warning-title'}</h3>
						<p class="mb-0 small">{_'policy.strictness.custom.warning'}</p>
					</div>
					<div class="table-responsive">
						<table class="table table-sm align-middle">
							<thead>
								<tr>
									<th scope="col">{_'policy.strictness.column.type'}</th>
									<th scope="col">{_'policy.strictness.column.hide'}</th>
									<th scope="col">{_'policy.strictness.column.review'}</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<th scope="row">{_'abuse.type.spam'}</th>
									<td><input n:name="spamHideMin" class="form-control form-control-sm"></td>
									<td class="small text-body-secondary">{_'policy.strictness.custom.spam-review'}</td>
								</tr>
								<tr n:foreach="$abuseTypes as $type">
									<th scope="row">{_"abuse.type.{$type->value}"}</th>
									<td><input n:name="{$type->value}_hide" class="form-control form-control-sm"></td>
									<td><input n:name="{$type->value}_review" class="form-control form-control-sm"></td>
								</tr>
								<tr class="table-danger">
									<th scope="row">{_'abuse.type.mixed'}</th>
									<td><input n:name="mixedHideMin" class="form-control form-control-sm"></td>
									<td class="small">{_'policy.strictness.custom.mixed-review'}</td>
								</tr>
							</tbody>
						</table>
					</div>
					<p class="small text-body-secondary">{_'policy.strictness.custom.empty'}</p>
				</div>

				<button n:name="send" class="btn btn-primary">{_'policy.strictness.save'}</button>
			</form>
		{else}
			{include rules, spam: $settings->hideMinSpamProbability, rules: $settings->abuseRules, mixed: $settings->mixedHideMin, types: $abuseTypes, confidence: $settings->hideMinConfidence}
		{/if}
		<p class="small text-body-secondary mb-0 mt-3">
			{_'policy.strictness.execution', 1, [mode => ("mode.{$policy->mode->value}"|translate), autoHide => (($settings->autoHide ? 'common.yes' : 'common.no')|translate)]}
		</p>
	</div>
</div>

<div class="row g-4">
	<div class="col-12 col-xl-7">
		<div class="card">
			<div class="card-header">
				{_'policy.current', 1, [version => $policy->version]}
				<span class="badge text-bg-info ms-2">{_"mode.{$policy->mode->value}"}</span>
			</div>
			<div class="card-body">
				<p n:if="$policy->version === 0" class="small text-body-secondary">{_'policy.default-note'}</p>
				{if $canManage}
					{control policyForm}
				{else}
					{var $settings = $policy->settings}
					<dl class="row mb-0">
						<dt class="col-sm-7">{_'policy.form.hideMinConfidence'}</dt><dd class="col-sm-5">{$settings->hideMinConfidence}</dd>
						<dt class="col-sm-7">{_'policy.form.replyMinConfidence'}</dt><dd class="col-sm-5">{$settings->replyMinConfidence}</dd>
						<dt class="col-sm-7">{_'policy.form.autoHide'}</dt><dd class="col-sm-5">{if $settings->autoHide}{_'common.yes'}{else}{_'common.no'}{/if}</dd>
						<dt class="col-sm-7">{_'policy.form.autoReplyCategories'}</dt>
						<dd class="col-sm-5">
							{foreach $settings->autoReplyCategories as $category}{_"category.{$category->value}"}{sep}, {/sep}{else}—{/foreach}
						</dd>
						<dt class="col-sm-7">{_'policy.form.languages'}</dt><dd class="col-sm-5">{implode(', ', $settings->languages)}</dd>
						<dt class="col-sm-7">{_'policy.form.otherLanguage'}</dt><dd class="col-sm-5">{_"action.{$settings->otherLanguage->value}"}</dd>
						<dt class="col-sm-7">{_'policy.form.autoRepliesPerConversation'}</dt><dd class="col-sm-5">{$settings->autoRepliesPerConversation}</dd>
						<dt class="col-sm-7">{_'policy.form.autoRepliesPerDay'}</dt><dd class="col-sm-5">{$settings->autoRepliesPerDay}</dd>
						<dt class="col-sm-7">{_'policy.form.maxLinks'}</dt><dd class="col-sm-5">{$settings->maxLinks ?? '—'}</dd>
						<dt class="col-sm-7">{_'policy.form.maxRepeats'}</dt><dd class="col-sm-5">{$settings->maxRepeats ?? '—'}</dd>
						<dt class="col-sm-7">{_'policy.form.repeatWindowHours'}</dt><dd class="col-sm-5">{$settings->repeatWindowHours}</dd>
						<dt class="col-sm-7">{_'policy.form.blockedDomains'}</dt>
						<dd class="col-sm-5 text-break">
							{foreach $settings->blockedDomains as $domain}{$domain}{sep}, {/sep}{else}—{/foreach}
						</dd>
					</dl>
				{/if}
			</div>
		</div>
	</div>

	<div class="col-12 col-xl-5">
		<div class="card">
			<div class="card-header">{_'policy.history'}</div>
			{if $history === []}
				<div class="card-body text-body-secondary">{_'policy.history-empty'}</div>
			{else}
				<ul class="list-group list-group-flush">
					<li n:foreach="$history as $item" class="list-group-item d-flex justify-content-between align-items-center gap-2">
						<span>
							v{$item->version} · {_"mode.{$item->mode}"}
							<span n:if="$item->active" class="badge text-bg-success ms-1">{_'policy.active'}</span>
						</span>
						<small class="text-body-secondary text-end">{$item->created_at|localTime}<br>{$item->created_by_name}</small>
					</li>
				</ul>
			{/if}
		</div>
	</div>
</div>


{define rules, float $spam, array $rules, ?float $mixed, array $types, float $confidence}
	<div class="row g-3 mb-3 small">
		<div class="col-md-4">
			<h3 class="h6">{_'policy.strictness.hides'}</h3>
			<span class="badge rounded-pill text-bg-danger">{_'abuse.type.spam'}</span>
			{foreach $types as $type}
				<span n:if="$rules[$type->value]->hideMin !== null" class="badge rounded-pill text-bg-danger">{_"abuse.type.{$type->value}"}</span>
			{/foreach}
			<span n:if="$mixed !== null" class="badge rounded-pill text-bg-danger">{_'abuse.type.mixed'}</span>
		</div>
		<div class="col-md-4">
			<h3 class="h6">{_'policy.strictness.reviews'}</h3>
			{foreach $types as $type}
				<span n:if="$rules[$type->value]->hideMin === null && $rules[$type->value]->reviewMin !== null" class="badge rounded-pill text-bg-warning">{_"abuse.type.{$type->value}"}</span>
			{/foreach}
		</div>
		<div class="col-md-4">
			<h3 class="h6">{_'policy.strictness.keeps'}</h3>
			<span class="badge rounded-pill text-bg-success">{_'policy.strictness.criticism'}</span>
			<span class="badge rounded-pill text-bg-success">{_'policy.strictness.disagreement'}</span>
			{foreach $types as $type}
				<span n:if="$rules[$type->value]->hideMin === null && $rules[$type->value]->reviewMin === null" class="badge rounded-pill text-bg-secondary">{_"abuse.type.{$type->value}"}</span>
			{/foreach}
		</div>
	</div>
	<div class="table-responsive">
		<table class="table table-sm align-middle small">
			<thead>
				<tr>
					<th scope="col">{_'policy.strictness.column.type'}</th>
					<th scope="col">{_'policy.strictness.column.criterion'}</th>
					<th scope="col">{_'policy.strictness.column.example'}</th>
					<th scope="col">{_'policy.strictness.column.outcome'}</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<th scope="row">{_'abuse.type.spam'}</th>
					<td>{_'policy.strictness.criterion.spam'}</td>
					<td class="fst-italic">{_'policy.strictness.example.spam'}</td>
					<td>{_'policy.strictness.outcome.spam', 1, [hide => ($spam|number:2)]}</td>
				</tr>
				<tr n:foreach="$types as $type">
					{var $rule = $rules[$type->value]}
					<th scope="row">{_"abuse.type.{$type->value}"}</th>
					<td>{_"policy.strictness.criterion.{$type->value}"}</td>
					<td class="fst-italic">{_"policy.strictness.example.{$type->value}"}</td>
					<td>
						{if $rule->hideMin !== null && $rule->reviewMin !== null}
							{_'policy.strictness.outcome.hide-review', 1, [hide => ($rule->hideMin|number:2), review => ($rule->reviewMin|number:2)]}
						{elseif $rule->hideMin !== null}
							{_'policy.strictness.outcome.hide', 1, [hide => ($rule->hideMin|number:2)]}
						{elseif $rule->reviewMin !== null}
							{_'policy.strictness.outcome.review', 1, [review => ($rule->reviewMin|number:2)]}
						{else}
							{_'policy.strictness.outcome.keep'}
						{/if}
					</td>
				</tr>
				<tr>
					<th scope="row">{_'abuse.type.mixed'}</th>
					<td>{_'policy.strictness.criterion.mixed'}</td>
					<td class="fst-italic">{_'policy.strictness.example.mixed'}</td>
					<td>
						{if $mixed === null}
							{_'policy.strictness.outcome.mixed-review'}
						{else}
							{_'policy.strictness.outcome.mixed-hide', 1, [hide => ($mixed|number:2)]}
						{/if}
					</td>
				</tr>
			</tbody>
		</table>
	</div>
	<ul class="small text-body-secondary mb-0">
		<li>{_'policy.strictness.rule.score'}</li>
		<li>{_'policy.strictness.rule.confidence', 1, [confidence => ($confidence|number:2)]}</li>
		<li>{_'policy.strictness.rule.threat'}</li>
		<li>{_'policy.strictness.rule.message'}</li>
		<li>{_'policy.strictness.rule.handoff'}</li>
	</ul>
{/define}
