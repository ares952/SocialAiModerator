{varType Nette\Database\Row $source}
{varType list<Nette\Database\Row> $versions}
{varType bool $canEdit}
{varType bool $canPublish}

{block content}
<nav aria-label="breadcrumb">
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a n:href="default">{_'knowledge.title'}</a></li>
		<li class="breadcrumb-item active" aria-current="page">{$source->key} ({$source->locale})</li>
	</ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
	<div>
		<h1 class="h3 mb-1" n:block="title">{$source->title}</h1>
		<div class="text-body-secondary">
			<code>{$source->key}</code> · {$source->locale} · v{$source->version} ·
			<span class="badge text-bg-light border">{_"knowledge.status.{$source->status}"}</span>
			· {_"knowledge.type.{$source->source_type}"}
		</div>
	</div>
	<div class="d-flex gap-2">
		<a n:if="$canEdit" class="btn btn-outline-primary" n:href="edit, id: $source->id">{_'knowledge.edit'}</a>
		{if $canPublish}
			<a n:if="$source->status !== 'published'" class="btn btn-success" n:href="publish!, version: $source->id">{_'knowledge.publish'}</a>
			<a n:if="$source->status === 'published'" class="btn btn-outline-danger" n:href="unpublish!, version: $source->id">{_'knowledge.unpublish'}</a>
		{/if}
	</div>
</div>

<div class="row g-4">
	<div class="col-12 col-xl-8">
		<div class="card">
			<div class="card-body">
				<p n:if="$source->valid_from || $source->valid_to" class="small text-body-secondary">
					{_'knowledge.validity'}: {$source->valid_from?->format('j. n. Y') ?? '…'} – {$source->valid_to?->format('j. n. Y') ?? '…'}
				</p>
				<div class="text-pre-wrap">{$source->content}</div>
			</div>
		</div>
	</div>
	<div class="col-12 col-xl-4">
		<div class="card">
			<div class="card-header">{_'knowledge.versions'}</div>
			<ul class="list-group list-group-flush">
				<li n:foreach="$versions as $version" n:class="list-group-item, $version->id === $source->id ? 'active'">
					<a n:href="detail, id: $version->id" n:class="$version->id === $source->id ? 'link-light' : 'link-body-emphasis', 'text-decoration-none'">v{$version->version}</a>
					<span class="badge text-bg-light border ms-1">{_"knowledge.status.{$version->status}"}</span>
					<div class="small">{$version->created_at|localTime} · {$version->created_by_name}</div>
					<div n:if="$version->approved_at" class="small">{_'knowledge.approved'}: {$version->approved_at|localTime} · {$version->approved_by_name}</div>
				</li>
			</ul>
		</div>
	</div>
</div>
