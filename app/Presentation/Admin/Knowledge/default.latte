{varType list<Nette\Database\Row> $sources}
{varType bool $canEdit}
{varType bool $canPublish}
{varType bool $hasDrafts}

{block content}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
	<h1 class="h3 mb-0" n:block="title">{_'knowledge.title'}</h1>
	<div n:if="$canEdit" class="d-flex gap-2">
		<a class="btn btn-outline-primary" n:href="import">{_'knowledge.import.title'}</a>
		<a class="btn btn-primary" n:href="add">{_'knowledge.add'}</a>
	</div>
</div>
<p class="text-body-secondary">{_'knowledge.note'}</p>

{if $sources === []}
	<div class="alert alert-secondary">{_'knowledge.empty'}</div>
{elseif $canPublish && $hasDrafts}
	<form n:name="publishForm">
		<div n:foreach="$form->getOwnErrors() as $error" class="alert alert-danger">{$error}</div>
		<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
			<button n:name="publish" class="btn btn-success">{_'knowledge.publish-selected'}</button>
			<span class="text-body-secondary small">{_'knowledge.publish-selected-note'}</span>
		</div>
		{include sourceTable, selectable: true}
	</form>
{else}
	{include sourceTable, selectable: false}
{/if}

{define sourceTable, bool $selectable}
	<div class="table-responsive">
		<table class="table table-hover align-middle">
			<thead>
				<tr>
					<th n:if="$selectable" scope="col">
						<input type="checkbox" class="form-check-input" data-check-all="versions[]" aria-label="{_'knowledge.select-all'}" title="{_'knowledge.select-all'}">
					</th>
					<th scope="col">{_'knowledge.column.key'}</th>
					<th scope="col">{_'knowledge.column.locale'}</th>
					<th scope="col">{_'knowledge.column.title'}</th>
					<th scope="col">{_'knowledge.column.latest'}</th>
					<th scope="col">{_'knowledge.column.published'}</th>
				</tr>
			</thead>
			<tbody>
				<tr n:foreach="$sources as $source">
					<td n:if="$selectable">
						<input n:if="$source->latest_status === 'draft'" n:name="versions:$source->id" class="form-check-input" aria-label="{$source->key} {$source->locale}">
					</td>
					<td><code>{$source->key}</code></td>
					<td>{$source->locale}</td>
					<td><a n:href="detail, id: $source->id">{$source->title}</a></td>
					<td>v{$source->latest_version} <span class="badge text-bg-light border">{_"knowledge.status.{$source->latest_status}"}</span></td>
					<td>
						{if $source->published_version !== null}
							<span class="badge text-bg-success">v{$source->published_version}</span>
						{else}
							<span class="text-body-secondary">—</span>
						{/if}
					</td>
				</tr>
			</tbody>
		</table>
	</div>
{/define}
