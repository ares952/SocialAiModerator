{block content}
<nav aria-label="breadcrumb">
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a n:href="default">{_'knowledge.title'}</a></li>
		<li class="breadcrumb-item active" aria-current="page">{_'knowledge.import.title'}</li>
	</ol>
</nav>

<div class="row">
	<div class="col-12 col-lg-8">
		<h1 class="h3 mb-3" n:block="title">{_'knowledge.import.title'}</h1>
		<p class="text-body-secondary">{_'knowledge.import.note'}</p>
		{control importForm}
	</div>
</div>
