{*
 * Chart drawn by www/assets/admin/charts.js from the definition of DashboardData. The canvas has a
 * text summary for screen readers; unless it is a sparkline, the values are also available as a
 * table under the chart (accessibility, no JavaScript).
 *}
{define chart, array $chart, string $size = 'md'}
	<div class="chart-box chart-box-{$size}">
		<canvas data-chart={$chart} role="img" aria-label="{$chart['summary']}"></canvas>
	</div>
	<details n:if="empty($chart['sparkline'])" class="small mt-2 chart-data">
		<summary class="text-body-secondary">{_'dashboard.chart.data'}</summary>
		<div class="table-responsive mt-2">
			<table class="table table-sm mb-0">
				<thead>
					<tr>
						<th scope="col"></th>
						<th n:foreach="$chart['datasets'] as $dataset" scope="col" class="text-end">{$dataset['label']}</th>
					</tr>
				</thead>
				<tbody>
					<tr n:foreach="$chart['labels'] as $index => $label">
						<th scope="row" class="fw-normal">{$label}</th>
						<td n:foreach="$chart['datasets'] as $dataset" class="text-end">{$dataset['data'][$index] ?? '—'}</td>
					</tr>
				</tbody>
			</table>
		</div>
	</details>
{/define}
