{varType array<string, int> $eventCounts}
{varType list<App\Ingest\EventStatus> $eventStatuses}
{varType array<string, int> $jobCounts}
{varType list<App\Queue\JobStatus> $jobStatuses}
{varType App\Moderation\Policy $policy}
{varType bool $paused}
{varType list<App\Monitoring\Alarm> $alarms}
{varType array<string, int|float|null> $day}
{varType array<string, int|float|null> $week}
{varType list<array{model: string, calls: int, input: int, output: int}> $tokens}

{block content}
<h1 class="h3 mb-4" n:block="title">{_'dashboard.title'}</h1>

<div n:class="alert, d-flex, flex-wrap, justify-content-between, align-items-center, gap-2, $paused ? 'alert-danger' : 'alert-secondary'">
	<span>
		{_'dashboard.mode'}: <strong>{_"mode.{$policy->mode->value}"}</strong>
		({_'policy.current', 1, [version => $policy->version]})
		· {if $paused}<strong>{_'automation.state.paused-short'}</strong>{else}{_'automation.state.running'}{/if}
	</span>
	<a n:href=":Admin:Policy:" class="alert-link">{_'dashboard.policy-link'}</a>
</div>

<div n:if="$alarms !== []" class="alert alert-warning">
	<div class="fw-semibold mb-1">{_'dashboard.alarms.title', count($alarms)}</div>
	<ul class="mb-0">
		<li n:foreach="$alarms as $alarm">{_"alarm.{$alarm->code}", (int) ($alarm->params['count'] ?? $alarm->params['days'] ?? $alarm->params['hours'] ?? $alarm->params['minutes'] ?? 1), $alarm->params}</li>
	</ul>
</div>
<p n:if="$alarms === []" class="text-body-secondary small">{_'dashboard.alarms.none'}</p>

<div class="card mb-4">
	<div class="card-header">{_'dashboard.metrics.title'}</div>
	<div class="table-responsive">
		<table class="table table-sm mb-0 align-middle">
			<thead>
				<tr>
					<th scope="col"></th>
					<th scope="col" class="text-end">{_'dashboard.metrics.day'}</th>
					<th scope="col" class="text-end">{_'dashboard.metrics.week'}</th>
				</tr>
			</thead>
			<tbody>
				<tr n:foreach="array_keys($day) as $metric">
					<td>{_"dashboard.metric.$metric"}</td>
					<td class="text-end">{$day[$metric] ?? '—'}</td>
					<td class="text-end">{$week[$metric] ?? '—'}</td>
				</tr>
			</tbody>
		</table>
	</div>
	<div class="card-body border-top small">
		<div class="fw-semibold mb-1">{_'dashboard.tokens.title'}</div>
		{if $tokens === []}
			<span class="text-body-secondary">{_'dashboard.tokens.none'}</span>
		{else}
			<div n:foreach="$tokens as $usage">
				<code>{$usage['model']}</code>: {_'dashboard.tokens.usage', $usage['calls'], [input => ($usage['input']|number), output => ($usage['output']|number)]}
			</div>
		{/if}
		<div class="text-body-secondary mt-1">{_'dashboard.tokens.note'}</div>
	</div>
</div>

<div class="row g-4">
	<div class="col-12 col-lg-6">
		<div class="card h-100">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span>{_'dashboard.events.title'}</span>
				<a class="small" n:href=":Admin:Events:">{_'dashboard.events.all'}</a>
			</div>
			<ul class="list-group list-group-flush">
				<li n:foreach="$eventStatuses as $status" class="list-group-item d-flex justify-content-between align-items-center">
					<a n:href=":Admin:Events:, status: $status->value" class="link-body-emphasis text-decoration-none">{_"event.status.{$status->value}"}</a>
					<span class="badge text-bg-secondary rounded-pill">{$eventCounts[$status->value] ?? 0}</span>
				</li>
			</ul>
		</div>
	</div>

	<div class="col-12 col-lg-6">
		<div class="card h-100">
			<div class="card-header">{_'dashboard.queue.title'}</div>
			<ul class="list-group list-group-flush">
				<li n:foreach="$jobStatuses as $status" class="list-group-item d-flex justify-content-between align-items-center">
					<span>{_"job.status.{$status->value}"}</span>
					<span n:class="badge, rounded-pill, $status->value === 'failed' && ($jobCounts[$status->value] ?? 0) > 0 ? 'text-bg-danger' : 'text-bg-secondary'">
						{$jobCounts[$status->value] ?? 0}
					</span>
				</li>
			</ul>
		</div>
	</div>
</div>
