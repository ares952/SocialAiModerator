# Copied to config/secrets/db.env (mode 0600) by deploy/bootstrap-environment.sh.
# Environment of the db container only. MARIADB_* values are applied on the first start with an
# empty datadir (data/mariadb); changing them later does not change existing accounts.

MARIADB_ROOT_PASSWORD=__DB_ROOT_PASSWORD__
MARIADB_DATABASE=moderator
MARIADB_USER=moderator
MARIADB_PASSWORD=__DB_PASSWORD__
