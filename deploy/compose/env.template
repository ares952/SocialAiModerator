# Copied to /.env by deploy/bootstrap-environment.sh. Values for Compose interpolation only;
# application secrets live in config/secrets/app.env.

TZ=Europe/Prague

# php and worker run as the checkout owner and the shared development group (socialai);
# filled in by the bootstrap.
APP_UID=__APP_UID__
APP_GID=__APP_GID__

# Address and port the container nginx is published on. The reverse proxy (TLS termination)
# connects here. Never use 0.0.0.0. Additional ports for this instance use WEB_PORT+1, +2, ...
WEB_BIND=127.0.0.1
WEB_PORT=9077

# Docker network "app". Must be a /24 that no other network on this host uses
# (check with `docker network inspect`).
APP_SUBNET=172.16.2.0/24
APP_GATEWAY=172.16.2.1
