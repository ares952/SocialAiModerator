# Copied to config/secrets/app.env (mode 0600) by deploy/bootstrap-environment.sh.
# Environment of the php and worker containers. Never commit the filled-in file.

APP_ENV=production
# Tracy debug mode exposes internals - keep 0 on any server reachable from the internet.
APP_DEBUG=0
APP_URL=https://moderator.example.com

DB_NAME=moderator
DB_USER=moderator
DB_PASSWORD=__DB_PASSWORD__

# Key for encrypting tokens and DM text at rest (base64, 32 bytes). During a rotation:
# "<new>,<old>", then bin/console encryption:rotate and remove the old key (docs/meta-webhooks.md).
APP_ENCRYPTION_KEY=__APP_ENCRYPTION_KEY__

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=__META_WEBHOOK_VERIFY_TOKEN__
META_GRAPH_API_VERSION=v27.0

OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=
OPENAI_REPLY_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest

AUTOMATION_DEFAULT_MODE=observe
MAX_AUTO_REPLIES_PER_CONVERSATION_PER_DAY=2
WORKER_CONCURRENCY=1
