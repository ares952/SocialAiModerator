parameters:
	# Administration UI languages (data/language_<code>.json); the first one is the default.
	languages:
		- cs
		- en

	# DB job queue (App\Queue\JobQueue). leaseSeconds must exceed the longest job, otherwise an
	# expired reservation lets another worker start the same job.
	queue:
		maxAttempts: 5
		backoffSeconds: 30
		backoffCapSeconds: 3600
		leaseSeconds: 600

	worker:
		# Pause when the queue is empty.
		idleSeconds: 1

	# Display time zone of the administration; the application and the database work in UTC.
	timezone: Europe/Prague

	# Failed sign-ins (App\Operator\LoginThrottle) within the window block further attempts.
	login:
		maxFailuresPerEmail: 5
		maxFailuresPerAddress: 20
		windowMinutes: 15


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\Presentation\*\**Presenter


database:
	dsn: 'mysql:host=%env.DB_HOST%;dbname=%env.DB_NAME%;charset=utf8mb4'
	user: %env.DB_USER%
	password: %env.DB_PASSWORD%
	options:
		lazy: true


latte:
	strictTypes: true
	strictParsing: true


tracy:
	# PHP-FPM keeps the environment (clear_env = no), so secrets from config/secrets/app.env are
	# in $_SERVER and in the `env` parameter. Bluescreens logged to log/ must never show them, nor
	# customer content. SensitiveParameterValue::$value: Tracy 2.12 writes the .md variant of a
	# bluescreen without the parameter names and would otherwise dump #[\SensitiveParameter] values.
	keysToHide:
		- SensitiveParameterValue::$value
		- App\Ingest\IncomingEvent::$payload
		# form fields with passwords besides `password` (hidden by default)
		- current
		- passwordCheck
		- DB_PASSWORD
		- APP_ENCRYPTION_KEY
		- META_APP_SECRET
		- META_WEBHOOK_VERIFY_TOKEN
		- OPENAI_API_KEY
		- App\Core\Encryptor::$key
		- App\Meta\WebhookVerifier::$appSecret
		- App\Meta\WebhookVerifier::$verifyToken


# Sessions live in the `redis` service (phpredis, persistent). The expiration also sets
# session.gc_maxlifetime, which phpredis uses as the TTL of every session.
session:
	expiration: 365 days
	cookieSecure: auto
	cookieSamesite: Lax
	saveHandler: redis
	savePath: 'tcp://redis:6379?prefix=socialai:session:'


security:
	authentication:
		# Sliding: every request extends the sign-in. OperatorAuthenticator re-validates the
		# operator on each request, so deactivation or a password change applies immediately.
		expiration: 365 days


extensions:
	console: Contributte\Console\DI\ConsoleExtension(%consoleMode%)
	migrations: Nextras\Migrations\Bridges\NetteDI\MigrationsExtension


console:
	name: Social AI Moderator
	catchExceptions: false


migrations:
	dir: %appDir%/../migrations
	driver: mysql
	dbal: nette
	withDummyData: false


di:
	export:
		parameters: false
		tags: false
