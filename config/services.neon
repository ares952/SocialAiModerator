services:
	- App\Core\RouterFactory::createRouter(%languages%)
	- App\Translation\Translator(languages: %languages%)
	- App\Translation\TranslationImporter(dataDir: %rootDir%/data)
	- App\Console\TranslationsImportCommand
	- App\Console\WorkerCommand(heartbeatFile: %tempDir%/worker.heartbeat, idleSeconds: %worker.idleSeconds%, retentionSeconds: %worker.retentionSeconds%, tokenCheckSeconds: %worker.tokenCheckSeconds%)
	- App\Console\OperatorCreateCommand
	- App\Console\OperatorPasswordCommand
	- App\Console\PasswordPrompt
	- App\Console\EvaluationImportCommand
	- App\Console\AccountTokenCommand
	- App\Console\EncryptionRotateCommand
	- App\Console\EventsNormalizeCommand
	- App\Console\RetentionRunCommand
	- App\Console\MonitorCheckCommand
	- App\Console\MetaCheckCommand
	- App\Console\MetaReadCommand
	- App\Core\Encryptor(%env.APP_ENCRYPTION_KEY%)
	- App\Core\Correlation
	- App\Core\Logger(file: %rootDir%/log/app.log)
	- App\Meta\WebhookVerifier(appSecret: %env.META_APP_SECRET%, verifyToken: %env.META_WEBHOOK_VERIFY_TOKEN%)
	- App\Meta\EventNormalizer
	- App\Ingest\EventStore
	- App\Ingest\EventProcessor
	- App\Ingest\EventOverview
	- App\Comment\Comments
	- App\Conversation\Conversations
	- App\Conversation\EchoGuard(appId: %env.META_APP_ID%)
	- App\Conversation\Inbox
	-
		create: App\Queue\JobQueue
		arguments:
			maxAttempts: %queue.maxAttempts%
			backoffSeconds: %queue.backoffSeconds%
			backoffCapSeconds: %queue.backoffCapSeconds%
			leaseSeconds: %queue.leaseSeconds%
	- App\Audit\AuditLog
	- App\Operator\Operators
	- App\Operator\OperatorAuthenticator
	- App\Operator\Authorization::create()
	-
		create: App\Operator\LoginThrottle
		arguments:
			maxPerEmail: %login.maxFailuresPerEmail%
			maxPerAddress: %login.maxFailuresPerAddress%
			windowMinutes: %login.windowMinutes%
	- App\Presentation\FormFactory
	- App\Moderation\PolicyEngine
	- App\Moderation\Decisions
	- App\Moderation\EventDecider
	- App\Moderation\ReviewQueue
	- App\Retention\Retention
	- App\Privacy\CustomerData
	- App\Monitoring\AlarmThresholds
	- App\Monitoring\Alarms(heartbeatFile: %tempDir%/worker.heartbeat, backupStatusFile: %tempDir%/backup.status)
	- App\Monitoring\Metrics
	- App\Monitoring\MetricSeries
	- App\Presentation\Admin\Charts
	- App\Presentation\Admin\Dashboard\DashboardData
	- App\Moderation\Policies(defaultMode: App\Moderation\Mode::from(%env.AUTOMATION_DEFAULT_MODE%))
	- App\Moderation\AutomationSwitch
	- App\Knowledge\KnowledgeBase(locales: %knowledge.locales%, timezone: %timezone%)
	- App\Knowledge\KnowledgeImport
	httpOpenAi:
		create: App\Ai\HttpOpenAiClient(%env.OPENAI_API_KEY%)
		autowired: false
	- App\Ai\GuardedOpenAiClient(client: @httpOpenAi)
	-
		create: App\Queue\CircuitBreaker
		arguments:
			failureThreshold: %circuitBreaker.failureThreshold%
			openSeconds: %circuitBreaker.openSeconds%
	- App\Ai\Classifier(model: %env.OPENAI_CLASSIFIER_MODEL%, moderationModel: %env.OPENAI_MODERATION_MODEL%)
	- App\Evaluation\EvaluationSamples
	- App\Evaluation\EvaluationRuns
	- App\Evaluation\EvaluationRunner
	- App\Account\Accounts
	- App\Account\Credentials
	- App\Account\TokenProvider
	- App\Account\TokenCheck(appId: %env.META_APP_ID%)
	- App\Meta\GraphApi(version: %env.META_GRAPH_API_VERSION%, appId: %env.META_APP_ID%)
	- App\Meta\HttpGraphReader(appId: %env.META_APP_ID%, appSecret: %env.META_APP_SECRET%)
	- App\Meta\HttpMetaClient
	- App\Outbox\Actions
	- App\Outbox\ActionDispatcher(pauseRetrySeconds: %outbox.pauseRetrySeconds%)
	- App\Outbox\ReplyDrafter
	- App\Ai\ReplyGenerator(model: %env.OPENAI_REPLY_MODEL%)


decorator:
	App\Presentation\BasePresenter:
		setup:
			- $appVersion = %appVersion%
			- $languages = %languages%
			- $timezone = %timezone%
