{
	"name": "social-ai-moderator/app",
	"description": "Moderation of Facebook Page and Instagram Professional comments and messages",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": ">=8.5",
		"contributte/console": "^0.11.0",
		"latte/latte": "^3.1",
		"nette/application": "^3.3",
		"nette/bootstrap": "^3.3",
		"nette/database": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.3",
		"nette/http": "^3.4",
		"nette/security": "^3.2",
		"nette/utils": "^4.1",
		"nextras/migrations": "^3.6",
		"tracy/tracy": "^2.12"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests"
		}
	},
	"scripts": {
		"test": "tester tests/ -C -s",
		"analyse": "phpstan analyse --no-progress --memory-limit=1G"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.5.13"
		}
	},
	"minimum-stability": "stable",
	"require-dev": {
		"nette/tester": "^2.7",
		"phpstan/phpstan": "^2.3"
	}
}
